  generator client {
    provider = "prisma-client-js"
    // output   = "../src/generated/prisma"
  }

  datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
  }

  enum Role {
    CUSTOMER
    STORE_MANAGER
    ADMIN
  }

  enum Gender {
    MALE
    FEMALE
    OTHER
  }

  enum AuthProvider {
    CREDENTIALS
    GOOGLE
  }

  model users {
    id String @id @default(cuid())

    // Personal Information
    name     String
    email    String  @unique
    phone    String?  @unique
    password String?
    gender   Gender?
    age      String?

    role Role @default(CUSTOMER)

    verificationOtp  String  @default("")
    verifyCodeExpire String
    isEmailVerified  Boolean @default(false)

    // Delivery Information
    defaultAddressId   String?
    dealerId            String?
    isServiceAvailable  Boolean @default(false)

    // Notification Preference
    emailNotification Boolean @default(true)
    pushNotification  Boolean @default(true)

    createAt DateTime @default(now())
    updateAt DateTime @default(now()) @updatedAt

    // Relations
    addresses address[]
  }


  ///////////////////////////// 📋  Category Schemas 📋 ///////////////////////////////////
  model categories {
    id          String   @id @default(cuid())
    name        String   @unique
    slug        String   @unique

    description String?
    image       String?

    isActive    Boolean  @default(true)
    sortOrder   Int      @default(0)

    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
  }


  /////////////////////////////  📋  Product Schemas  📋 ///////////////////////////////////
  model products {
    id          String   @id @default(cuid())
    name        String   @unique
    slug        String   @unique

    shortDescription String?
    description      String?

    categories    String[]
    subcategories  String[] @default([])

    mrp           Decimal  @db.Decimal(10, 2)
    sellingPrice  Decimal  @db.Decimal(10, 2)
    tax           Decimal  @db.Decimal(10, 2) @default(0)

    weight    String
    unit      String
    shelfLife String
    country   String

    thumbnail     String?
    galleryImages String[] @default([])

    isActive Boolean @default(true)

    // Sales tracking (managed by backend only)
    numberOfTimesBuy Int @default(0)
    totalSold        Int @default(0)
    totalRevenue     Decimal @default(0) @db.Decimal(12, 2)
    averageRating    Decimal @default(0) @db.Decimal(3, 2)
    numberOfReviews  Int @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
  }



////////////////////////////// 📋 User Address Model 📋 ////////////////////////////////////////

enum AddressLabel {
  HOME
  WORK
  OTHER
}

model address {
  id          String   @id @default(cuid())

  userId      String

  label       AddressLabel   // HOME, WORK, OTHER

  house       String?
  street      String?
  landmark    String?

  city        String
  state       String
  country     String
  pincode     String

  latitude    Float
  longitude   Float
  apiAddress  String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        users     @relation(fields: [userId], references: [id])
}


